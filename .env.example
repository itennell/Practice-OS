# Copy this file to .env and fill in each value. Never commit .env.

# Supabase > your Practice-OS project > Connect > Transaction pooler connection string.
# Use the shared pooler (host aws-0-<region>.pooler.supabase.com, user postgres.<project-ref>, port 6543).
# The db.<project-ref>.supabase.co host is IPv6-only and fails on many home networks and on Vercel.
DATABASE_URL=
# The project ref from that string (the part after "postgres."). db:reset refuses any other project.
SUPABASE_PROJECT_REF=
# Encrypts stored Instagram/Gmail sign-ins. Make one with: openssl rand -base64 32
# Keep it safe: if it is lost, stored sign-ins must be reconnected.
CONNECTIONS_ENCRYPTION_KEY=

# Meta model API dashboard (api.meta.ai) > API keys
MODEL_API_KEY=

# Twilio Console home page > Account Info box
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Console > Phone Numbers > the number you buy for the practice (format +13125550100)
TWILIO_PHONE_NUMBER=
# Your own phone, verified in Twilio > Verified Caller IDs. Crisis alerts and all test texts go here.
CLINICIAN_ALERT_PHONE=

# Cal.com > Settings > Developer > API keys
CALCOM_API_KEY=
# Cal.com > Event Types > your consult event (the number in its URL)
CALCOM_EVENT_TYPE_ID=

# developers.facebook.com > your app > Instagram > API setup (the access token itself is stored in the database)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# A random string you make up and paste into the Meta webhook settings
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Google Cloud Console > APIs & Services > Credentials > OAuth client for the Gmail API, drafts only (gmail.compose).
# The Gmail sign-in token is stored in the database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Your own test inbox. Every referral letter draft is addressed here.
TEST_INBOX_EMAIL=

# Your Vercel URL once deployed (needed to check Twilio signatures), e.g. https://practice-os.vercel.app
PUBLIC_BASE_URL=

# You choose: view-only password for the Vercel copy
DEMO_PASSWORD=
# You choose: only you have it; needed to approve anything on the Vercel copy
ADMIN_PASSWORD=
# Vercel copy only: a long random string; Vercel sends it to the daily memory cron (/api/cron/reflect)
CRON_SECRET=

# true = executors log instead of sending, posting or booking
DRY_RUN=true

# Optional. A self-hosted Firecrawl (e.g. http://100.x.x.x:3002) for the state-research
# skill and `tests/rule-sources.test.ts`. Some state sites block plain scripted fetches.
FIRECRAWL_URL=

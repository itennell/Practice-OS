#!/bin/sh
# After `git pull` or a merge: if package-lock.json changed, install the new packages
# at once, so no page breaks on a package that isn't there yet.
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -qx "package-lock.json"; then
  echo "package-lock.json changed: running npm install..."
  npm install --no-audit --no-fund || echo "npm install failed. Run it yourself before starting the app."
fi

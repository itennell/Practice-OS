# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Practice-OS: never commit these
.env
.mcp.json
test/
*.m4a
*.mp3
*.wav
.claude/settings.local.json
.agents/
!.env.example

# Playwright output
/test-results/
/playwright-report/
/.playwright-cli/

# Public CA certificates the app ships (no private keys)
!lib/certs/*.pem

# Local model cache (the name-finder for the sensitive-info guard)
/.cache/

# Aeon's memory, rendered from practice_os.memories
aeon/MEMORY.md

# The built-in database, its generated keys and its backups (lib/local-db.ts)
/.data/
/relay/node_modules/
/relay/.vercel/

# The app log when INSTALL.md starts it in the background
/dev.log
